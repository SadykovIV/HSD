<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.hsd.universal.permission.EMBED_DISPLAY" />
    <application>
        <activity android:name="com.hsd.universal.qa.BackStackRoot" android:exported="true"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.hsd.universal.qa.ProjectionTestVpn"
            android:exported="true" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
        </service>
    </application>
</manifest>
