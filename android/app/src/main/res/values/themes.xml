<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Setup uses a dark canvas; native fields and system icons must match it in light mode too. -->
    <style name="Theme.HSD.Dex" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#10151E</item>
        <item name="android:colorBackground">#10151E</item>
        <item name="android:colorAccent">#F2B33D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/golos</item>
    </style>
    <!-- Диалог всегда тёмный: акцент и цвет текста свои, иначе из светлой темы приложения протекают тёмные @color/acc и @color/on (заголовок и кнопки сливаются с фоном) -->
    <style name="Theme.HSD.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/acc_dlg</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@font/golos</item>
    </style>
</resources>
